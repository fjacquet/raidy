{
  "name": "raidy",
  "private": true,
  "version": "3.1.2",
  "type": "module",
  "description": "Browser-based simulator for modern storage infrastructure (RAID, ZFS, vSAN, S2D, Nutanix, Dell, NetApp, Ceph, Synology, Longhorn). 100% client-side.",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks",
    "prebuild": "node scripts/check-supply-chain.mjs && npm run check:dead",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:dead": "knip"
  },
  "dependencies": {
    "d3-sankey": "^0.12.3",
    "dompurify": "^3.4.14",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lz-string": "^1.5.0",
    "pptxgenjs-plus": "^4.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-i18next": "^17.0.12",
    "sonner": "^2.0.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
